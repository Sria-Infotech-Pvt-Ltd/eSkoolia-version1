# Frontend dependencies and build output
frontend/node_modules/
frontend/.next/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*dbsqlite
*.docx

# Backend migrations are source code and must be tracked
!backend/**/migrations/
!backend/**/migrations/*.py
!backend/**/migrations/**/__init__.py# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments
backend/venv/
backend/t/
.venv/

# Django
db.sqlite3
*.log
backend/logs/

# User-uploaded media (photos, documents) — runtime content, not source
backend/media/
# Saved Django debug-error pages (DEBUG=True technical_500 dumps can contain
# request locals — DB URLs, tokens — that Django's settings redaction doesn't cover)
error.html
backend/error.html

# Env
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
frontend/.env*
backend/.env

# Next.js / Node
frontend/node_modules/
frontend/.next/
out/
# TypeScript incremental build cache — regenerated by every tsc/next build,
# and conflicted on every merge while it was tracked.
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

multi-school-tenant-erp/node_modules/
multi-school-tenant-erp/.next/
